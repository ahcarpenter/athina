{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "component": "Athina",
  "include-component-in-tag": false,
  "include-v-in-release-name": false,
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "chore(release): ${version}",
  "pull-request-footer": "GitHub runs no checks on a pull request that GitHub Actions opened or pushed to, so close and reopen this one right before merging it, and its required checks run on its head (docs/releasing.md \"Each release\").",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "xml",
          "path": "Resources/Info.plist",
          "xpath": "/plist/dict/key[text()='CFBundleShortVersionString']/following-sibling::string[1]"
        }
      ]
    }
  }
}

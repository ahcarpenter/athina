#!/usr/bin/env bash
# The Athina end-to-end harness: one entry point that prepares a warm replay
# home, runs named scenarios against the real app, hermetically through its
# control API or on the real screen, and prints a machine-readable result with
# the evidence each one produced.
#
#   scripts/e2e/athina-e2e warm          prepare the warm fixture home (once)
#   scripts/e2e/athina-e2e list          the scenarios and what each proves
#   scripts/e2e/athina-e2e run all       run them, one line of JSON each
#   scripts/e2e/athina-e2e doctor        what is missing before a run
#
# The real-screen tier's scenarios are scripts in scenarios/; the API tier's
# are Swift Testing tests in Tests/E2EAPITests, which `run` builds and runs
# with `swift test`, printing and counting their results with the others.
#
# Every run is replay only: no API key is read, no network is reachable, and
# nothing is billed. See docs/e2e.md.
set -euo pipefail

# mapfile and the array forms below need bash 4; macOS still ships 3.2 as
# /bin/bash, so say so rather than fail somewhere in the middle of a run.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
	echo "athina-e2e needs bash 4 or newer (this is ${BASH_VERSION:-unknown})" >&2
	exit 1
fi

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/harness.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/lock.sh
source "$E2E_DIR/lib/lock.sh"

KEEP_HOME=0
OUT_ROOT=""
TIME_SCALE=""
LOCK_TIMEOUT=""
TIER=""

usage() {
	cat <<'TEXT'
usage: scripts/e2e/athina-e2e <command> [options]

  list                     the scenarios and what each one proves
  warm [--force]           prepare the warm fixture home (needs the screen)
  run <scenario|all> ...   run scenarios end to end
  run --tier <api|screen|all>
                           run every scenario of a tier
  journal <query> [--home <dir>]
                           a named query over a run's journal
  doctor                   check everything a run needs
  clean [--warm]           remove past runs, and the warm home with --warm

options:
  --out <dir>        where evidence goes (default: a dated directory per run)
  --keep-home        keep the scratch home after a run, to look inside it
  --time-scale <n>   run the replay clock n times faster (see docs/replay.md)
  --jobs <n>         run up to n API-tier scenarios at once, beside the
                     real-screen ones (default 1: one scenario at a time)
  --tier <api|screen|all>
                     run only the scenarios of that tier, every one of them
                     when no scenario is named (default all)
  --show-windows     leave an API-tier run's windows on screen to watch it,
                     taking the screen lock as a real-screen run does
  --checkpoints <dir> put the API tier's checkpoints in <dir>/<scenario>/
                     rather than in each run's evidence
  --launch open      launch the API tier's app through LaunchServices rather
                     than sandbox-exec, as CI does; refused on a Mac with
                     Athina data of its own (docs/ci.md "Checkpoints")
  --lock-timeout <s> give up after s seconds when another run holds the
                     screen or this checkout (default: wait for as long as
                     it takes)

run and warm first take this checkout's lock, so only one of them runs from a
checkout at a time, then build. An API-tier scenario is hermetic and takes no
other lock. A real-screen scenario takes one machine-wide lock for as long as
it runs, as warm and clean do for theirs, so only one run is on the screen at a
time across every checkout, and one that says SCENARIO_IDLE_FIRST=yes only
once the keyboard and mouse have been quiet for 15 seconds (docs/e2e.md).
TEXT
}

# How long the keyboard and mouse must be quiet before a scenario that says
# SCENARIO_IDLE_FIRST=yes takes the screen: its steps start soon after and each
# moves the pointer or the front app, which whoever is at the Mac would feel.
IDLE_BEFORE_SCREEN=15

cmd_list() {
	local name
	for name in $(scenario_names); do
		printf '%-24s %s\n' "$name" "$(scenario_summary_of "$name")"
	done
}

cmd_doctor() {
	local ok=0
	ensure_drive
	printf 'repository       %s\n' "$ROOT"
	printf 'app bundle       %s\n' "$([ -x "$APP_BINARY" ] && echo "$APP" || echo "missing (run make build)")"
	printf 'hermetic copy    %s\n' "$([ -x "$E2E_BINARY" ] && echo "$E2E_APP ($E2E_BUNDLE_ID)" || echo "not made yet: the first API-tier run makes it")"
	printf 'drive tool       %s\n' "$([ -x "$DRIVE" ] && echo "$DRIVE" || echo "missing")"
	printf 'fixtures         %s\n' "$([ -d "$FIXTURES" ] && echo "$FIXTURES" || echo "missing")"
	printf 'warm home        %s\n' "$(have_warm_home && echo "$WARM_HOME (warmed $(warm_home_stamp))" || echo "not prepared: run athina-e2e warm")"
	"$DRIVE" permissions | sed 's/^/permission       /'
	printf 'screen lock      %s, %s\n' "$SCREEN_LOCK" "$(lock_status SCREEN_LOCK)"
	printf 'checkout lock    %s, %s\n' "$CHECKOUT_LOCK" "$(lock_status CHECKOUT_LOCK)"
	local tool
	for tool in sqlite3 jq sandbox-exec screencapture; do
		command -v "$tool" >/dev/null || { printf 'missing tool     %s\n' "$tool"; ok=1; }
	done
	[ -x "$APP_BINARY" ] || ok=1
	have_warm_home || ok=1
	return $ok
}

# Prepare the warm fixture home.
#
# A fresh scratch home has no text-recognition model cache, so its first
# capture blocks 30 to 60 seconds inside OCR. This pays that cost once: it runs
# a replay in a throwaway home until a capture with recognised text lands, then
# keeps the home's caches and throws its journal away. Every later run clones
# it, which is instant on APFS.
cmd_warm() {
	local force=0
	[ "${1:-}" = "--force" ] && force=1
	if have_warm_home && [ "$force" = 0 ]; then
		log "warm home is already prepared ($(warm_home_stamp)); --force to redo it"
		return 0
	fi
	ensure_app
	RUN_DIR="$RUNS_ROOT/warm-$(date '+%Y%m%d-%H%M%S')"
	mkdir -p "$RUN_DIR"
	# Keep the half-built home if this fails: its journal is the only place
	# that says why no capture arrived.
	KEEP_HOME=1
	trap 'cleanup; locks_release' EXIT
	prefs_save

	local building="$CACHE_ROOT/warm-home.building"
	rm -rf "$building"
	mkdir -p "$building/Library/Application Support/athina"
	HOME_DIR="$building"
	seed_settings "$building"

	local started elapsed
	started=$(date +%s)
	# Sensing captures nothing while an excluded app is in front, and the
	# terminal a run is started from is excluded, so warming needs the same
	# staged app a scenario has.
	stage_text_document
	launch_athina "$building"
	stage_flip_window
	log "waiting for the first capture with recognised text (this is the slow one, once)"
	local ocr=0 tick=0
	for _ in $(seq 1 180); do
		tick=$((tick + 1))
		kill -USR1 "$FLIP_PID" 2>/dev/null || true
		wake_input
		[ $((tick % 5)) = 0 ] && raise_window "$TEXTEDIT_PID" notes.txt
		ocr="$(sqlite3 -readonly "$JOURNAL" "select coalesce(max(length(ocr_text)), 0) from observations" 2>/dev/null || echo 0)"
		[ "${ocr:-0}" -gt 0 ] && break
		[ $((tick % 20)) = 0 ] && log "still waiting: $(journal_count observations) capture(s), $(journal_count events) event(s)"
		sleep 1
	done
	elapsed=$(( $(date +%s) - started ))
	[ "${ocr:-0}" -gt 0 ] || die "no capture with recognised text after ${elapsed}s; see $RUN_DIR/app.log"
	log "first recognised capture after ${elapsed}s ($ocr characters)"

	stop_pid "$ATHINA_PID"
	ATHINA_PID=""
	sleep 1
	# Keep the caches, drop everything the session wrote about itself.
	rm -rf "$building/Library/Application Support/athina"
	date '+%Y-%m-%d %H:%M:%S' >"$building/.athina-e2e-warm"
	rm -rf "$WARM_HOME"
	mkdir -p "$(dirname "$WARM_HOME")"
	mv "$building" "$WARM_HOME"
	HOME_DIR=""
	rm -rf "$CACHE_ROOT/warm-home.building"
	log "warm home ready at $WARM_HOME (cold first capture took ${elapsed}s; clones pay none of it)"
	printf '{"warm_home": "%s", "cold_first_capture_seconds": %d}\n' "$WARM_HOME" "$elapsed"
}

# How run_scenario says a scenario was skipped, neither passed nor failed.
SCENARIO_SKIPPED=77
# How an outcome records a failure of a scenario on the quarantine list,
# Tests/quarantine.json: reported, not counted as failed, and never run again
# (docs/testing.md "Quarantine").
SCENARIO_QUARANTINED=78

cmd_run() {
	local names=() name chosen
	[ $# -gt 0 ] || [ -n "$TIER" ] || { usage; exit 64; }
	chosen="$(scenarios_to_run "${TIER:-all}" "$@")" || exit 1
	"$ROOT/scripts/quarantine.sh" check || exit 1
	mapfile -t names <<<"$chosen"
	ensure_app
	local api=() screen=()
	for name in "${names[@]}"; do
		if [ "$(scenario_tier_of "$name")" = api ]; then api+=("$name"); else screen+=("$name"); fi
	done
	# The API tier reads no screen and runs no text recognition, so only the
	# real-screen tier needs the warm home.
	if [ ${#screen[@]} -gt 0 ]; then
		have_warm_home || die "no warm home yet: run scripts/e2e/athina-e2e warm first"
	fi
	[ ${#api[@]} -eq 0 ] || [ "$CONTROL_API" = no ] || ensure_api_tests
	OUTCOMES="$(mktemp -d "${TMPDIR:-/tmp}/athina-e2e-outcomes.XXXXXX")"
	if [ "$JOBS" -le 1 ]; then
		for name in ${screen[@]+"${screen[@]}"}; do run_one "$name"; done
		run_api_tier ${api[@]+"${api[@]}"}
	else
		# The real-screen tier one at a time beside the API tier, each of its
		# scenarios taking the screen lock for itself, and the API tier up to
		# $JOBS at a time, taking none.
		(for name in ${screen[@]+"${screen[@]}"}; do run_one "$name"; done) 8>&- &
		run_api_tier ${api[@]+"${api[@]}"}
		wait
	fi
	tally
}

# The API tier's scenarios named, through `swift test` (Tests/E2EAPITests), up
# to $JOBS at once, each launching a hermetic replay of its own. Every test
# writes its result line where this finds it, and each is printed and counted
# as a real-screen scenario's is; a scenario that left none, because the test
# run stopped before it ended, fails. A bundle without the control API, as
# every release build is, cannot run them, so each is skipped.
run_api_tier() {
	[ $# -gt 0 ] || return 0
	local name
	if [ "$CONTROL_API" = no ]; then
		local reason="$APP carries no control API, which the API tier drives; run it on the development build of the same commit"
		for name in "$@"; do
			log "=== $name: skipped, $reason"
			result_line "$name" skip 0 "$reason"
			keep_outcome "$name" "$SCENARIO_SKIPPED"
		done
		return 0
	fi
	local results status=0 file found result
	results="$(mktemp -d "${TMPDIR:-/tmp}/athina-e2e-results.XXXXXX")"
	log "=== the API tier: $* (up to $JOBS at once)"
	(
		# Windows left on screen to watch put the run on the screen, so it
		# takes the machine-wide lock for as long as it runs.
		if [ "$SHOW_WINDOWS" = 1 ]; then
			lock_acquire SCREEN_LOCK "run the API tier" "$LOCK_TIMEOUT" || exit $?
		fi
		cd "$ROOT" && ATHINA_E2E_HERMETIC_APP="$E2E_APP" ATHINA_E2E_BUNDLE="$APP" \
			ATHINA_E2E_OUT="${OUT_ROOT:-$RUNS_ROOT}" ATHINA_E2E_CHECKPOINTS="$CHECKPOINTS_ROOT" \
			ATHINA_E2E_RESULTS="$results" ATHINA_E2E_LAUNCH="$LAUNCH_WITH" \
			ATHINA_E2E_SHOW_WINDOWS="$SHOW_WINDOWS" ATHINA_E2E_KEEP_HOME="$KEEP_HOME" \
			ATHINA_E2E_TIME_SCALE="$TIME_SCALE" ATHINA_E2E_JOBS="$JOBS" \
			swift test --skip-build --traits E2EAPI --scratch-path "$API_BUILD" \
			--filter "Scenarios/\`($(IFS='|'; printf '%s' "$*"))\`\\(\\)" >&2 8>&- 9>&-
	) || status=$?
	for name in "$@"; do
		found=0
		for file in "$results/$name"-*.json; do
			[ -e "$file" ] || continue
			found=1
			cat "$file"
			result="$(sed -n 's/.*"result":"\([a-z]*\)".*/\1/p' "$file")"
			case "$result" in
			pass) keep_outcome "$name" 0 ;;
			skip) keep_outcome "$name" "$SCENARIO_SKIPPED" ;;
			*) keep_outcome "$name" 1 ;;
			esac
		done
		if [ "$found" = 0 ]; then
			result_line "$name" fail 0 "it left no result: swift test stopped, with status $status, before it ended"
			keep_outcome "$name" 1
		fi
	done
	rm -rf "$results"
}

# One scenario, its outcome kept where tally finds it.
run_one() {
	local outcome=0
	run_scenario "$1" || outcome=$?
	keep_outcome "$1" "$outcome"
}

# Keeps scenario $1's outcome $2 where tally finds it; a failure of a
# quarantined scenario is reported and kept as quarantined instead.
keep_outcome() {
	local name="$1" outcome="$2"
	if [ "$outcome" != 0 ] && [ "$outcome" != "$SCENARIO_SKIPPED" ] \
		&& "$ROOT/scripts/quarantine.sh" scenario "$name"; then
		"$ROOT/scripts/quarantine.sh" report "$name"
		outcome="$SCENARIO_QUARANTINED"
	fi
	printf '%s\n' "$outcome" >"$(mktemp "$OUTCOMES/outcome.XXXXXX")"
}

tally() {
	local passed=0 failed=0 skipped=0 quarantined=0 outcome file
	for file in "$OUTCOMES"/outcome.*; do
		[ -e "$file" ] || continue
		outcome="$(cat "$file")"
		case "$outcome" in
		0) passed=$((passed + 1)) ;;
		"$SCENARIO_SKIPPED") skipped=$((skipped + 1)) ;;
		"$SCENARIO_QUARANTINED") quarantined=$((quarantined + 1)) ;;
		*) failed=$((failed + 1)) ;;
		esac
	done
	rm -rf "$OUTCOMES"
	log "$passed passed, $failed failed, $skipped skipped$([ "$quarantined" = 0 ] || echo ", and $quarantined quarantined failed, not counted")"
	[ "$failed" = 0 ]
}

# A new evidence directory for a scenario: its name and the time, with a
# number after it when a copy of the same scenario started in the same second.
make_run_dir() {
	local base n=1 dir
	base="${OUT_ROOT:-$RUNS_ROOT}/$1-$(date '+%Y%m%d-%H%M%S')"
	mkdir -p "$(dirname "$base")"
	dir="$base"
	until mkdir "$dir" 2>/dev/null; do
		n=$((n + 1))
		dir="$base-$n"
	done
	printf '%s\n' "$dir"
}

# One real-screen scenario, driven from outside with the real pointer and
# accessibility.
run_scenario() (
	# A subshell per scenario: its trap, its variables, and its exit cannot
	# reach the next one.
	local name="$1"
	local file="$SCENARIO_DIR/$name.sh"

	SCENARIO_SUMMARY=""
	SCENARIO_ARGS=()
	SCENARIO_SETTINGS='{}'
	# A real-screen scenario that also reads Athina through its control API,
	# to set what macOS shows beside what the app built, says yes. It gets one
	# only from a bundle that carries it, and reads CONTROL_API to know.
	SCENARIO_CONTROL=no
	# A scenario that takes the screen only once the keyboard and mouse have
	# been quiet says yes.
	SCENARIO_IDLE_FIRST=no
	# What sensing watches: a staged TextEdit window, unless the scenario
	# stages something else.
	scenario_stage() { stage_text_document; }
	# shellcheck disable=SC1090
	source "$file"

	[ "$JOBS" -gt 1 ] && LOG_TAG="[$name] "
	# A real-screen run is on the screen: it takes the machine-wide lock for as
	# long as it runs, so other checkouts' runs interleave with this one's. A
	# scenario that needs a quiet keyboard and mouse waits for them before it
	# takes it, rather than inside it.
	local status=0
	if [ "$SCENARIO_IDLE_FIRST" = yes ]; then
		lock_acquire_when_idle SCREEN_LOCK "run $name" "$LOCK_TIMEOUT" "$IDLE_BEFORE_SCREEN" hid_idle_seconds || status=$?
	else
		lock_acquire SCREEN_LOCK "run $name" "$LOCK_TIMEOUT" || status=$?
	fi
	if [ "$status" != 0 ]; then
		result_line "$name" fail 0 "could not take the screen lock"
		exit "$status"
	fi

	RUN_DIR="$(make_run_dir "$name")"
	# While this is here, clean leaves the run alone.
	printf '%s\n' "$BASHPID" >"$RUN_DIR/.running"
	log "=== $name (screen tier): $SCENARIO_SUMMARY"
	log "evidence: $RUN_DIR"

	trap cleanup EXIT
	record_build_provenance
	prefs_save
	HOME_DIR="$RUN_DIR/home"
	new_home "$HOME_DIR"
	seed_settings "$HOME_DIR" "$SCENARIO_SETTINGS"

	local args=()
	[ ${#SCENARIO_ARGS[@]} -gt 0 ] && args+=("${SCENARIO_ARGS[@]}")
	[ -n "$TIME_SCALE" ] && args+=(--time-scale "$TIME_SCALE")
	local started result detail
	started=$(date +%s)

	scenario_stage
	if [ "$SCENARIO_CONTROL" = yes ] && [ "$CONTROL_API" = yes ]; then
		control_prepare
		args+=(--control "$CONTROL_DIR")
	fi
	launch_athina "$HOME_DIR" ${args[@]+"${args[@]}"}
	[ -n "$CONTROL_DIR" ] && control_wait
	watch_announcements
	watch_clicks
	wait_first_observation 90 || log "WARNING: no capture yet; the home may not be warm"

	detail=""
	local ran=0
	scenario_run || ran=$?
	if [ "$ran" = 0 ]; then
		if [ "$CHECKS_FAILED" = 0 ]; then
			result=pass
		else
			result=fail
			detail="$CHECKS_FAILED check(s) failed"
		fi
	else
		result=fail
		detail="the scenario could not run to the end"
		[ -n "$STEP" ] && detail="$detail: it stopped at step $STEP"
	fi
	write_evidence
	log "=== $name: $result"
	result_line "$name" "$result" "$(( $(date +%s) - started ))" "$detail"
	[ "$result" = pass ]
)

cmd_journal() {
	local query="${1:-}" home="${2:-}"
	[ -n "$query" ] || { usage; exit 64; }
	if [ -z "$home" ]; then
		home="$(find "$RUNS_ROOT" -maxdepth 2 -name 'journal.sqlite' -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1)"
		[ -n "$home" ] || die "no run journal found; pass --home <dir>"
		"$DRIVE" journal "$home" "$query"
		return
	fi
	# Each launch keeps its journal in a directory of its own under the home's
	# replay root, so the newest one there is the run being asked about.
	local journal
	# `|| true` so a replay root that is not there reaches the guard below: under
	# `set -euo pipefail` the failing `find` would otherwise end the script here,
	# silently, in exactly the case the message names.
	journal="$(find "$home/Library/Application Support/athina/replay" -maxdepth 2 -name 'journal.sqlite' -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1 || true)"
	[ -n "$journal" ] || die "no journal under $home; that home may hold no replay"
	"$DRIVE" journal "$journal" "$query"
}

cmd_clean() {
	# An API-tier run takes no lock that clean waits on, so one of another
	# checkout's may be running now; its evidence stays.
	local dir pid kept=0
	for dir in "$RUNS_ROOT"/*; do
		[ -e "$dir" ] || continue
		pid="$(cat "$dir/.running" 2>/dev/null || true)"
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kept=$((kept + 1))
			continue
		fi
		rm -rf "$dir"
	done
	log "removed the runs in $RUNS_ROOT$([ "$kept" = 0 ] || echo ", except $kept still running")"
	# What the hermetic copy leaves behind outside the runs: its preferences
	# domain, and the Accessibility row macOS writes, denied, the first time an
	# app it has not seen asks whether it is trusted (docs/e2e.md "Hermetic runs").
	if [ "$kept" = 0 ]; then
		defaults delete "$E2E_BUNDLE_ID" >/dev/null 2>&1 && log "removed the $E2E_BUNDLE_ID preferences"
		tccutil reset Accessibility "$E2E_BUNDLE_ID" >/dev/null 2>&1 && log "reset $E2E_BUNDLE_ID's Accessibility entry"
	fi
	if [ "${1:-}" = "--warm" ]; then
		rm -rf "$WARM_HOME" "$CACHE_ROOT/warm-home.building"
		log "removed $WARM_HOME"
	fi
}

main() {
	local command="${1:-}"
	shift || true
	local rest=()
	while [ $# -gt 0 ]; do
		case "$1" in
		--out) OUT_ROOT="$2"; shift 2 ;;
		--keep-home) KEEP_HOME=1; shift ;;
		--time-scale) TIME_SCALE="$2"; shift 2 ;;
		--lock-timeout) LOCK_TIMEOUT="$2"; shift 2 ;;
		--jobs)
			[[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { echo "--jobs takes a whole number of scenarios, 1 or more" >&2; exit 64; }
			JOBS="$2"; shift 2 ;;
		--show-windows) SHOW_WINDOWS=1; shift ;;
		--tier)
			case "${2:-}" in api | screen | all) TIER="$2" ;; *) echo "--tier is api, screen or all" >&2; exit 64 ;; esac
			shift 2 ;;
		--checkpoints)
			[ -n "${2:-}" ] || { echo "--checkpoints takes a directory" >&2; exit 64; }
			mkdir -p "$2" && CHECKPOINTS_ROOT="$(cd "$2" && pwd)"; shift 2 ;;
		--launch)
			case "${2:-}" in open | sandbox) LAUNCH_WITH="$2" ;; *) echo "--launch is open or sandbox" >&2; exit 64 ;; esac
			shift 2 ;;
		--home) rest+=("$2"); shift 2 ;;
		*) rest+=("$1"); shift ;;
		esac
	done
	mkdir -p "$RUNS_ROOT"
	local what="$command${rest[*]:+ ${rest[*]}}" status=0
	if checkout_lock_needed "$command"; then
		# Held to the end, so a second run from this checkout waits here
		# rather than build over the bundle this one runs from.
		checkout_lock_acquire "$what" "$LOCK_TIMEOUT" || status=$?
		[ "$status" = 0 ] || exit "$status"
		# Exiting gives the locks back however the run ends; this also takes
		# down their holder files. warm sets its own trap, which does both.
		trap locks_release EXIT
		# Built before the screen lock is taken, so no other checkout waits
		# on this one's build. The commands build the app again only if a
		# source file is saved after this build starts; athina-drive is built
		# here alone.
		ensure_app
		ensure_drive
	fi
	if screen_lock_needed "$command"; then
		lock_acquire SCREEN_LOCK "$what" "$LOCK_TIMEOUT" || status=$?
		[ "$status" = 0 ] || exit "$status"
		trap locks_release EXIT
	fi
	case "$command" in
	list) cmd_list ;;
	warm) cmd_warm ${rest[@]+"${rest[@]}"} ;;
	run) cmd_run ${rest[@]+"${rest[@]}"} ;;
	journal) cmd_journal ${rest[@]+"${rest[@]}"} ;;
	doctor) cmd_doctor ;;
	clean) cmd_clean ${rest[@]+"${rest[@]}"} ;;
	"" | -h | --help | help) usage ;;
	*) usage; exit 64 ;;
	esac
}

main "$@"

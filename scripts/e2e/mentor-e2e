#!/usr/bin/env bash
# The Mentor end-to-end harness: one entry point that prepares a warm replay
# home, runs named scenarios against the real app on the real screen, and
# prints a machine-readable result with the evidence each one produced.
#
#   scripts/e2e/mentor-e2e warm          prepare the warm fixture home (once)
#   scripts/e2e/mentor-e2e list          the scenarios and what each proves
#   scripts/e2e/mentor-e2e run all       run them, one line of JSON each
#   scripts/e2e/mentor-e2e doctor        what is missing before a run
#
# Every run is replay only: no API key is read, no network is reachable, and
# nothing is billed. See README, "End-to-end harness".
set -euo pipefail

# mapfile and the array forms below need bash 4; macOS still ships 3.2 as
# /bin/bash, so say so rather than fail somewhere in the middle of a run.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
	echo "mentor-e2e needs bash 4 or newer (this is ${BASH_VERSION:-unknown})" >&2
	exit 1
fi

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/harness.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCENARIO_DIR="$E2E_DIR/scenarios"
KEEP_HOME=0
OUT_ROOT=""
TIME_SCALE=""

usage() {
	cat <<'TEXT'
usage: scripts/e2e/mentor-e2e <command> [options]

  list                     the scenarios and what each one proves
  warm [--force]           prepare the warm fixture home (needs the screen)
  run <scenario|all> ...   run scenarios end to end
  journal <query> [--home <dir>]
                           a named query over a run's journal
  doctor                   check everything a run needs
  clean [--warm]           remove past runs, and the warm home with --warm

options:
  --out <dir>        where evidence goes (default: a dated directory per run)
  --keep-home        keep the scratch home after a run, to look inside it
  --time-scale <n>   run the replay clock n times faster (see README)
TEXT
}

scenario_names() {
	local path
	for path in "$SCENARIO_DIR"/*.sh; do
		[ -e "$path" ] || continue
		basename "$path" .sh
	done
}

scenario_summary_of() {
	# Read the summary without running anything the scenario defines.
	sed -n 's/^SCENARIO_SUMMARY="\(.*\)"$/\1/p' "$SCENARIO_DIR/$1.sh" | head -1
}

cmd_list() {
	local name
	for name in $(scenario_names); do
		printf '%-24s %s\n' "$name" "$(scenario_summary_of "$name")"
	done
}

cmd_doctor() {
	local ok=0
	ensure_drive
	printf 'repository       %s\n' "$ROOT"
	printf 'app bundle       %s\n' "$([ -x "$APP_BINARY" ] && echo "$APP" || echo "missing (run make build)")"
	printf 'drive tool       %s\n' "$([ -x "$DRIVE" ] && echo "$DRIVE" || echo "missing")"
	printf 'fixtures         %s\n' "$([ -d "$FIXTURES" ] && echo "$FIXTURES" || echo "missing")"
	printf 'warm home        %s\n' "$(have_warm_home && echo "$WARM_HOME (warmed $(warm_home_stamp))" || echo "not prepared: run mentor-e2e warm")"
	"$DRIVE" permissions | sed 's/^/permission       /'
	local tool
	for tool in sqlite3 python3 sandbox-exec screencapture; do
		command -v "$tool" >/dev/null || { printf 'missing tool     %s\n' "$tool"; ok=1; }
	done
	[ -x "$APP_BINARY" ] || ok=1
	have_warm_home || ok=1
	return $ok
}

# Prepare the warm fixture home.
#
# A fresh scratch home has no text-recognition model cache, so its first
# capture blocks 30 to 60 seconds inside OCR. This pays that cost once: it runs
# a replay in a throwaway home until a capture with recognised text lands, then
# keeps the home's caches and throws its journal away. Every later run clones
# it, which is instant on APFS.
cmd_warm() {
	local force=0
	[ "${1:-}" = "--force" ] && force=1
	if have_warm_home && [ "$force" = 0 ]; then
		log "warm home is already prepared ($(warm_home_stamp)); --force to redo it"
		return 0
	fi
	ensure_app
	ensure_drive
	RUN_DIR="$RUNS_ROOT/warm-$(date '+%Y%m%d-%H%M%S')"
	mkdir -p "$RUN_DIR"
	trap cleanup EXIT
	prefs_save

	local building="$CACHE_ROOT/warm-home.building"
	rm -rf "$building"
	mkdir -p "$building/Library/Application Support/mentor"
	HOME_DIR="$building"
	seed_settings "$building"

	local started elapsed
	started=$(date +%s)
	launch_mentor "$building"
	stage_flip_window
	log "waiting for the first capture with recognised text (this is the slow one, once)"
	local ocr=0
	for _ in $(seq 1 180); do
		kill -USR1 "$FLIP_PID" 2>/dev/null || true
		ocr="$(sqlite3 -readonly "$JOURNAL" "select coalesce(max(length(ocr_text)), 0) from observations" 2>/dev/null || echo 0)"
		[ "${ocr:-0}" -gt 0 ] && break
		sleep 1
	done
	elapsed=$(( $(date +%s) - started ))
	[ "${ocr:-0}" -gt 0 ] || die "no capture with recognised text after ${elapsed}s; see $RUN_DIR/app.log"
	log "first recognised capture after ${elapsed}s ($ocr characters)"

	stop_pid "$MENTOR_PID"
	MENTOR_PID=""
	sleep 1
	# Keep the caches, drop everything the session wrote about itself.
	rm -rf "$building/Library/Application Support/mentor"
	date '+%Y-%m-%d %H:%M:%S' >"$building/.mentor-e2e-warm"
	rm -rf "$WARM_HOME"
	mkdir -p "$(dirname "$WARM_HOME")"
	mv "$building" "$WARM_HOME"
	HOME_DIR=""
	log "warm home ready at $WARM_HOME (cold first capture took ${elapsed}s; clones pay none of it)"
	printf '{"warm_home": "%s", "cold_first_capture_seconds": %d}\n' "$WARM_HOME" "$elapsed"
}

cmd_run() {
	local names=("$@") name status=0
	[ ${#names[@]} -gt 0 ] || { usage; exit 64; }
	if [ "${names[0]}" = "all" ]; then
		mapfile -t names < <(scenario_names)
	fi
	ensure_app
	ensure_drive
	have_warm_home || die "no warm home yet: run scripts/e2e/mentor-e2e warm first"
	for name in "${names[@]}"; do
		run_scenario "$name" || status=1
	done
	return $status
}

run_scenario() (
	# A subshell per scenario: its trap, its variables, and its exit cannot
	# reach the next one.
	local name="$1"
	local file="$SCENARIO_DIR/$name.sh"
	[ -f "$file" ] || die "no scenario named $name"

	SCENARIO_SUMMARY=""
	SCENARIO_ARGS=()
	SCENARIO_SETTINGS='{}'
	scenario_stage() { stage_text_document; }
	# shellcheck disable=SC1090
	source "$file"

	RUN_DIR="${OUT_ROOT:-$RUNS_ROOT}/$name-$(date '+%Y%m%d-%H%M%S')"
	mkdir -p "$RUN_DIR"
	log "=== $name: $SCENARIO_SUMMARY"
	log "evidence: $RUN_DIR"

	trap cleanup EXIT
	prefs_save
	HOME_DIR="$RUN_DIR/home"
	new_home "$HOME_DIR"
	seed_settings "$HOME_DIR" "$SCENARIO_SETTINGS"

	local args=()
	[ ${#SCENARIO_ARGS[@]} -gt 0 ] && args+=("${SCENARIO_ARGS[@]}")
	[ -n "$TIME_SCALE" ] && args+=(--time-scale "$TIME_SCALE")
	local started result detail
	started=$(date +%s)

	scenario_stage
	launch_mentor "$HOME_DIR" ${args[@]+"${args[@]}"}
	watch_announcements
	watch_clicks
	wait_first_observation 90 || log "WARNING: no capture yet; the home may not be warm"

	detail=""
	if scenario_run; then
		if [ "$CHECKS_FAILED" = 0 ]; then
			result=pass
		else
			result=fail
			detail="$CHECKS_FAILED check(s) failed"
		fi
	else
		result=fail
		detail="the scenario could not run to the end"
	fi
	write_evidence
	log "=== $name: $result"
	result_line "$name" "$result" "$(( $(date +%s) - started ))" "$detail"
	[ "$result" = pass ]
)

cmd_journal() {
	local query="${1:-}" home="${2:-}"
	[ -n "$query" ] || { usage; exit 64; }
	if [ -z "$home" ]; then
		home="$(find "$RUNS_ROOT" -maxdepth 2 -name 'journal.sqlite' -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1)"
		[ -n "$home" ] || die "no run journal found; pass --home <dir>"
		"$DRIVE" journal "$home" "$query"
		return
	fi
	"$DRIVE" journal "$home/Library/Application Support/mentor/replay/journal.sqlite" "$query"
}

cmd_clean() {
	rm -rf "$RUNS_ROOT"
	log "removed $RUNS_ROOT"
	if [ "${1:-}" = "--warm" ]; then
		rm -rf "$WARM_HOME" "$CACHE_ROOT/warm-home.building"
		log "removed $WARM_HOME"
	fi
}

main() {
	local command="${1:-}"
	shift || true
	local rest=()
	while [ $# -gt 0 ]; do
		case "$1" in
		--out) OUT_ROOT="$2"; shift 2 ;;
		--keep-home) KEEP_HOME=1; shift ;;
		--time-scale) TIME_SCALE="$2"; shift 2 ;;
		--home) rest+=("$2"); shift 2 ;;
		*) rest+=("$1"); shift ;;
		esac
	done
	mkdir -p "$RUNS_ROOT"
	case "$command" in
	list) cmd_list ;;
	warm) cmd_warm ${rest[@]+"${rest[@]}"} ;;
	run) cmd_run ${rest[@]+"${rest[@]}"} ;;
	journal) cmd_journal ${rest[@]+"${rest[@]}"} ;;
	doctor) cmd_doctor ;;
	clean) cmd_clean ${rest[@]+"${rest[@]}"} ;;
	"" | -h | --help | help) usage ;;
	*) usage; exit 64 ;;
	esac
}

main "$@"
